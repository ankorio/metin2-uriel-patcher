    {"type": "value",  "key": "NEAR_DIST", "label": "Arrived within"},
    {"type": "checkbox", "key": "VERBOSE", "label": "Log every sidestep"},
    {"type": "button", "label": "Revert", "action": "reset", "x": 10}
  ]
