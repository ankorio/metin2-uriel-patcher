{
  "title": "Routes",
  "hint": "Scripted travel: walk paths, closed hunting loops, channel hops and map exits, handing control to autohunt2 (or a future worker) at each stop. Routes live in config ROUTES or are recorded in game: /route mark at each corner, then /route save <name> loop. Run with /route run <name>, stop with /route stop.",
  "rows": [
    { "type": "value", "key": "AUTORUN", "label": "Run on login (profile)" },
