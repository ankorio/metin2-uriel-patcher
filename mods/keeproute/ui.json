{
  "title": "Keep route",
  "hint": "Resumes a walk that combat interrupted. A walk you cancelled yourself is left alone - the difference is whether you had an attack target at the moment the route died.",
  "rows": [
    {
      "type": "slider",
      "key": "RESUME_EVERY",
      "label": "Resume at most every",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "suffix": "s"
    },
    {
      "type": "slider",
      "key": "RESUME_LIMIT",
      "label": "Give up after",
      "min": 1,
      "max": 40,
      "step": 1,
      "suffix": " tries"
    },
    { "type": "checkbox", "key": "VERBOSE", "label": "Log every resume" },
    { "type": "button", "label": "Revert", "action": "reset", "x": 10 }
  ]
}
